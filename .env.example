# Copy to .env and fill in your values — never commit .env
PORT=4000

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGEME_use_openssl_rand_base64_48

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp
DB_USER=postgres
DB_PASSWORD=CHANGEME_strong_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=localhost:9092

# CORS — comma-separated allowed origins (use * only in development)
ALLOWED_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
